{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WS Debugger Django",
            "type": "debugpy",
            "justMyCode": false,
            "request": "launch",
            "args": [
                "runserver",
                "8080"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\task-app-django\\manage.py",
            "cwd": "${workspaceFolder}\\task-app-django",
            "envFile": "${workspaceFolder}\\task-app-django\\.env"
        },
        {
            "name": "Python: Django - Shell",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\task-app-django\\manage.py",
            "cwd": "${workspaceFolder}\\task-app-django",
            "envFile": "${workspaceFolder}\\task-app-django\\.env",
            "args": [
                "shell"
            ],
            "django": true,
            "console": "integratedTerminal",
            "justMyCode": true
        },
    ]
}