{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/qwen3-coder:30b",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",

      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },

      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "num_ctx": 32768
          }
        },
        "qwen3:8b": {
          "name": "Qwen 3 8B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "num_ctx": 32768
          }
        },
        "devstral-small-2:latest": {
          "name": "Devstral Small 2 24B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "num_ctx": 32768
          }
        }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "write": "allow",
    "run": "allow",
    "bash": "allow"
  }
}