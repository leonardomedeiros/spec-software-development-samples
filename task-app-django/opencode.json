{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/deepseek-r1:latest",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",

      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },

      "models": {
        "deepseek-r1:latest": {
          "name": "deepseek-r1:latest",
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "num_ctx": 16384
          }
        }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "write": "allow",
    "run": "allow",
    "bash": "allow"
  }
}